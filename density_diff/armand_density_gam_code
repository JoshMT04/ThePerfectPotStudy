## The landscape model

```{r model}
m6 <- readRDS(file.path(params$fit_dir, params$fit_main))
sm <- m6$smooth[[1]]; idx <- sm$first.para:sm$last.para
f_at <- function(X, chunk = 50000) {
  X <- as.data.frame(X); names(X) <- P
  out <- numeric(nrow(X))
  for (s in seq(1, nrow(X), by = chunk)) {
    r <- s:min(nrow(X), s + chunk - 1)
    out[r] <- PredictMat(sm, cbind(X[r, , drop = FALSE], L = 1)) %*% coef(m6)[idx]
  }
  out
}
nodes <- h[is_parent_vase == FALSE]
X_nodes <- as.matrix(nodes[, ..P])
f_nodes <- f_at(X_nodes)
f_ref <- sample(f_nodes, 5000)
p_beat <- function(fx) vapply(fx, function(v) mean(plogis(v - f_ref)), 0)
```

## Do human endpoints sit higher on the landscape than their random twins?

In six dimensions, with no projection. For each human round, the attractiveness of its generation-5 choice is compared with the mean over its 10 random twins. The landscape was fitted to the same human choices, so this checks the model's consistency with where the choices led, not an independent test.

```{r uphill}
fh <- h5[, .(participant_id, play_counter, rnd, f_h = f_at(as.matrix(.SD))), .SDcols = P]
fn <- n5[, .(participant_id, play_counter, rnd, f_n = f_at(as.matrix(.SD))), .SDcols = P][
  , .(f_n = mean(f_n)), by = round_key]
up <- merge(fh, fn, by = round_key)
up_tab <- data.table(
  statistic = c("rounds", "human endpoint higher than mean of random twins (%)",
                "mean P(beats random), human endpoints", "mean P(beats random), random endpoints"),
  value = c(nrow(up), 100 * mean(up$f_h > up$f_n), mean(p_beat(up$f_h)), mean(p_beat(fn$f_n))))
knitr::kable(up_tab, digits = 3)
fwrite(up_tab, file.path(params$out_dir, "benchmark_uphill.csv"))
```

## Selection arrows

δ_i = human endpoint − mean of the random twins' endpoints (6-D). Its agreement with the local uphill direction of the landscape, ∇f at the round's starting point, in 6-D:

```{r arrows6d}
Xn_mean <- n5[, lapply(.SD, mean), by = round_key, .SDcols = P]
arr <- merge(merge(h5[, c(round_key, P), with = FALSE], Xn_mean, by = round_key, suffixes = c("_h", "_n")),
             start, by = round_key)
D <- as.matrix(arr[, paste0(P, "_h"), with = FALSE]) - as.matrix(arr[, paste0(P, "_n"), with = FALSE])
S <- as.matrix(arr[, ..P])
grad_at <- function(X, h = 1e-3) {
  n <- nrow(X)
  Xs <- do.call(rbind, lapply(1:6, function(j) { Xp <- X; Xp[, j] <- Xp[, j] + h; Xm <- X; Xm[, j] <- Xm[, j] - h; rbind(Xp, Xm) }))
  v <- f_at(Xs)
  sapply(1:6, function(j) { o <- (j - 1) * 2 * n; (v[o + 1:n] - v[o + n + 1:n]) / (2 * h) })
}
G <- grad_at(S)
cosv <- rowSums(D * G) / (sqrt(rowSums(D^2)) * sqrt(rowSums(G^2)))
ar_tab <- data.table(
  statistic = c("median arrow length (PC units)", "arrows pointing uphill at the start (%)",
                "mean cosine(arrow, gradient)", "cosine of the mean arrow with the mean gradient"),
  value = c(median(sqrt(rowSums(D^2))), 100 * mean(cosv > 0), mean(cosv),
            sum(colMeans(D) * colMeans(G)) / (sqrt(sum(colMeans(D)^2)) * sqrt(sum(colMeans(G)^2)))))
knitr::kable(ar_tab, digits = 3)
fwrite(ar_tab, file.path(params$out_dir, "benchmark_arrows.csv"))
```

## Maps

```{r maps}
rng0 <- apply(as.matrix(rbind(h[, ..P], n[null_repeat == 1, ..P])), 2, range)
grid_of <- function(a, b, n = params$grid_n) list(u = seq(rng0[1, a], rng0[2, a], length.out = n),
                                                 v = seq(rng0[1, b], rng0[2, b], length.out = n))

# A. landscape averaged over the four PCs not shown (partial dependence), cached
pd_file <- file.path(params$out_dir, sprintf("pd_cache_%s_g%d_r%d.rds", sub(".rds$", "", params$fit_main), params$grid_n, params$pd_ref_n))
pd <- if (file.exists(pd_file)) readRDS(pd_file) else {
  ref <- X_nodes[sample(nrow(X_nodes), params$pd_ref_n), ]
  r <- lapply(planes, function(ab) {
    gr <- grid_of(ab[1], ab[2]); g <- CJ(u = gr$u, v = gr$v)
    fbar <- vapply(seq_len(nrow(g)), function(i) {
      X <- ref; X[, ab[1]] <- g$u[i]; X[, ab[2]] <- g$v[i]; mean(f_at(X)) }, 0)
    g[, fbar := fbar]; g })
  saveRDS(r, pd_file); r }

# B. log density ratio, human vs random, with the range between random repeats
kde_on <- function(x, y, gr, bw) MASS::kde2d(x, y, h = bw, n = length(gr$u), lims = c(range(gr$u), range(gr$v)))$z
dens_on <- function(ngrid) lapply(planes, function(ab) {
  a <- P[ab[1]]; b <- P[ab[2]]; gr <- grid_of(ab[1], ab[2], ngrid)
  bw <- params$dens_bw_mult * c(MASS::bandwidth.nrd(n5[[a]]), MASS::bandwidth.nrd(n5[[b]]))
  zh <- kde_on(h5[[a]], h5[[b]], gr, bw)
  zn <- kde_on(n5[[a]], n5[[b]], gr, bw)
  # null: each repeat against the other nine, same sample sizes as human vs pooled
  zr <- lapply(1:10, function(r) {
    z1 <- kde_on(n5[null_repeat == r][[a]], n5[null_repeat == r][[b]], gr, bw)
    z9 <- kde_on(n5[null_repeat != r][[a]], n5[null_repeat != r][[b]], gr, bw)
    list(lr = as.vector(log(z1 / z9)), dd = as.vector(z1 - z9)) })
  g <- data.table(u = rep(gr$u, times = length(gr$v)), v = rep(gr$v, each = length(gr$u)))   # kde2d z is [u, v]: u runs fastest
  g[, lr := as.vector(log(zh / zn))]
  g[, null_sd := apply(sapply(zr, `[[`, "lr"), 1, sd)]
  g[, z := lr / null_sd]
  # raw density difference (SI), per unit area in PC units^2, with its own chance range
  g[, dd := as.vector(zh - zn)]
  g[, dd_z := dd / apply(sapply(zr, `[[`, "dd"), 1, sd)]
  # mask where the random games put too few vases: below the density level enclosing 99% of them
  dn <- as.vector(zn); o <- order(dn, decreasing = TRUE)
  cut <- dn[o][which(cumsum(dn[o]) / sum(dn) >= 0.99)[1]]
  g[dn < cut, `:=`(lr = NA, z = NA, dd = NA, dd_z = NA)]
  g })
dens_c <- dens_on(params$grid_n)       # same grid as the averaged landscape: masks and A-vs-B statistics
dens   <- dens_on(params$dens_grid_n)  # fine grid: drawing

# C. kernel-smoothed selection field in each plane: weighted mean displacement at each grid point
arrows <- rbindlist(lapply(seq_along(planes), function(i) {
  a <- planes[[i]][1]; b <- planes[[i]][2]
  step <- max(diff(rng0[, a]), diff(rng0[, b])) / params$arrow_per_axis
  bw <- params$arrow_bw * step
  qa <- quantile(S[, a], c(.01, .99)); qb <- quantile(S[, b], c(.01, .99))
  g <- CJ(x = seq(qa[1], qa[2], by = step), y = seq(qb[1], qb[2], by = step))
  r <- g[, {
    w <- exp(-((S[, a] - x)^2 + (S[, b] - y)^2) / (2 * bw^2))
    sw <- sum(w); sw2 <- sum(w^2)
    ma <- sum(w * D[, a]) / sw; mb <- sum(w * D[, b]) / sw
    va <- sum(w * (D[, a] - ma)^2) / sw; vb <- sum(w * (D[, b] - mb)^2) / sw
    .(eff_n = sw^2 / sw2, dx = ma, dy = mb, se_x = sqrt(va * sw2) / sw, se_y = sqrt(vb * sw2) / sw)
  }, by = .(x, y)]
  r[, mag := sqrt(dx^2 + dy^2)]
  # standardised strength: displacement in SDs of each PC among the random games' gen-5 choices (the mutation step scales with each PC's spread)
  r[, mag_sd := sqrt((dx / sd(n5[[P[a]]]))^2 + (dy / sd(n5[[P[b]]]))^2)]
  r[, se_mag := sqrt((dx * se_x)^2 + (dy * se_y)^2) / mag]
  r[, clear := mag > 2 * se_mag]
  r[, `:=`(plane = i, step = step, bw = bw)]
  r[eff_n >= params$arrow_min_eff_n] }))
fwrite(arrows, file.path(params$out_dir, "benchmark_arrow_field.csv"))
cat(sprintf("arrow glyphs per plane: %s; clearly non-zero: %s\n",
            paste(arrows[, .N, by = plane]$N, collapse = ", "),
            paste(arrows[, sum(clear), by = plane]$V1, collapse = ", ")))

# numeric agreement between rows A and B, within the unmasked region
agree <- rbindlist(lapply(seq_along(planes), function(i) {
  m <- merge(pd[[i]], dens_c[[i]], by = c("u", "v"))[!is.na(lr)]
  data.table(plane = paste(P[planes[[i]]], collapse = "/"), cells = nrow(m),
             r_landscape_vs_logratio = cor(m$fbar, m$lr, method = "spearman"),
             cells_significant_pct = 100 * mean(abs(m$z) > params$z_crit)) }))
knitr::kable(agree, digits = 3, caption = "Spearman correlation between the averaged landscape (row A) and the log density ratio (row B), over grid cells where the random games put vases")
fwrite(agree, file.path(params$out_dir, "benchmark_agreement.csv"))
```

## Figure

```{r figure, fig.width = 7.2, fig.height = 5.3}
lims_p <- range(unlist(lapply(pd, function(g) p_beat(range(g$fbar)))))
lr_max <- params$lr_cap   # interior-scaled; noisy rim cells would otherwise stretch the scale
base <- function() list(coord_equal(expand = FALSE), theme_classic(base_size = 8))

masked_pd <- function(i) {
  g <- merge(copy(pd[[i]]), dens_c[[i]][, .(u, v, lr)], by = c("u", "v"))
  g[, p := p_beat(fbar)][is.na(lr), p := NA]
  g }
row_a <- lapply(seq_along(planes), function(i) {
  ttl <- if (i == 1) "A  Landscape, averaged over the other PCs" else NULL
  g <- masked_pd(i)
  ggplot(g, aes(u, v)) + geom_raster(aes(fill = p)) +
    geom_contour(aes(z = p), breaks = seq(0.1, 0.9, 0.05), colour = "grey30", linewidth = 0.2) +
    scale_fill_gradient2(low = "#2166AC", mid = "white", high = "#B2182B", midpoint = 0.5, limits = lims_p,
                         na.value = "grey85", name = "P(beats\nrandom)") +
    labs(x = P[planes[[i]][1]], y = P[planes[[i]][2]], title = ttl) + base() })
mag_lim <- c(0, max(arrows$mag_sd))
row_b <- lapply(seq_along(planes), function(i) {
  ttl <- if (i == 1) "B  Selected gen-5 vases, log(human / random), and direction of selection" else NULL
  g <- dens[[i]]
  ar <- arrows[plane == i][, `:=`(ux = dx / mag, uy = dy / mag)]
  half <- params$arrow_len * ar$step[1] / 2
  ggplot(g, aes(u, v)) + geom_raster(aes(fill = lr)) +
    geom_contour(aes(z = abs(z)), breaks = params$z_crit, colour = "grey40", linewidth = 0.2) +
    scale_fill_gradient2(low = "#2166AC", mid = "white", high = "#B2182B", midpoint = 0,
                         limits = c(-lr_max, lr_max), oob = scales::squish, na.value = "grey85",
                         name = "log(human /\nrandom)") +
    geom_segment(data = ar, aes(x = x - half * ux, y = y - half * uy, xend = x + half * ux, yend = y + half * uy,
                                colour = mag_sd, alpha = clear),
                 inherit.aes = FALSE, linewidth = 0.3,
                 arrow = grid::arrow(length = grid::unit(0.6, "mm"), type = "closed", angle = 30)) +
    scale_colour_gradient(low = "grey65", high = "black", limits = mag_lim, name = "displacement\n(SD of PC)") +
    scale_alpha_manual(values = c(`FALSE` = 0.25, `TRUE` = 1), guide = "none") +
    labs(x = P[planes[[i]][1]], y = P[planes[[i]][2]], title = ttl) + base() })

fig <- (wrap_plots(row_a, nrow = 1) / wrap_plots(row_b, nrow = 1)) +
  plot_layout(guides = "collect")
print(fig)
ggsave(file.path(params$out_dir, "figure_benchmark.pdf"), fig, width = 183, height = 135, units = "mm")
ggsave(file.path(params$out_dir, "figure_benchmark.png"), fig, width = 183, height = 135, units = "mm", dpi = 200, bg = "white")
```


## SI figure: the raw density difference

Human minus random density of the chosen generation-5 vases (per unit area, PC units²), same kernel estimates, mask and planes as row B. Unlike the log ratio, this weights selection by how many vases were in each region.

```{r rawdiff, fig.width = 7.2, fig.height = 2.8}
# each plane on its own colour scale: density per unit area differs between planes (see caption)
row_d <- lapply(seq_along(planes), function(i) {
  dd_max <- max(abs(quantile(dens[[i]]$dd, c(.005, .995), na.rm = TRUE)))
  ggplot(dens[[i]], aes(u, v)) + geom_raster(aes(fill = dd)) +
    geom_contour(aes(z = abs(dd_z)), breaks = params$z_crit, colour = "black", linewidth = 0.3) +
    scale_fill_gradient2(low = "#2166AC", mid = "white", high = "#B2182B", midpoint = 0,
                         limits = c(-dd_max, dd_max), oob = scales::squish, na.value = "grey85",
                         name = NULL) +
    labs(x = P[planes[[i]][1]], y = P[planes[[i]][2]]) + base() +
    theme(legend.position = "bottom", legend.key.width = grid::unit(8, "mm"), legend.key.height = grid::unit(2, "mm"),
          legend.text = element_text(size = 5)) })
fig_d <- wrap_plots(row_d, nrow = 1)
